# LCARS dashboard settings. Contains passwords/tokens: keep private.
PORT=

# Big text in the top bar (default: HOME LAB OPERATIONS)
# DASHBOARD_TITLE=

# The server the backend runs on (name shown on its panel, network interface to watch)
SERVER_NAME=
SERVER_NIC=

# Synology NAS (SNMP v2c)
NAS_NAME=
NAS_HOST=
NAS_SNMP_COMMUNITY=
NAS_IFACE=

# Mac stats helper (mac-helper/), e.g. http://<mac-ip>:8089
MAC_NAME=
MAC_STATS_URL=

# Plex via Tautulli (API key comes from Tautulli > Settings > Web Interface)
TAUTULLI_URL=
TAUTULLI_API_KEY=

# MeshCore via RemoteTerm
REMOTETERM_URL=
REMOTETERM_USER=
REMOTETERM_PASS=
# Hide channels whose name contains any of these words (comma separated). Default: test
# MESH_HIDE_CHANNELS_WITH=test

# Outdoor weather + air quality (Open-Meteo, no key). Decimal latitude/longitude of home.
WEATHER_NAME=
WEATHER_LAT=
WEATHER_LON=
# WEATHER_UNITS=metric   (default is °F / mph)

# Indoor temps (e.g. ecobee) via Home Assistant, e.g. http://<ha-ip>:8123
# HA_TOKEN: HA > your profile (bottom left) > Security > Long-lived access tokens > Create token
HA_URL=
HA_TOKEN=
# Room sensors to show, NAME=entity_id pairs e.g. Upstairs=sensor.upstairs_temperature,Downstairs=sensor.downstairs_temperature
INDOOR_ROOMS=
# The thermostat (climate.* entity). Blank = the only one there is.
INDOOR_THERMOSTAT=

# Hot tub via Home Assistant (e.g. the ha-bestway add-on). Shares the Outside spot; tap to switch.
# HOTTUB_THERMOSTAT is its climate.* entity; the add-on's power/filter/errors entities are found from it.
HOTTUB_THERMOSTAT=
# HOTTUB_NAME=HOT TUB

# Solar repeater telemetry (MeshCore, asked over the mesh via RemoteTerm)
REPEATER_NAME=
# Admin or guest password for the repeater (blank = guest login)
REPEATER_PASSWORD=
# Minutes between radio requests (keep it 30 or more to be kind to the mesh)
# REPEATER_POLL_MIN=60
